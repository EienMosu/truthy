{
  "format": 1,
  "module": "components/play/ticketScroll",
  "function": "statementScroll",
  "source": "components/play/ticketScroll.ts",
  "tests": [
    "tests/components/play/ticketScroll.test.ts"
  ],
  "cards": {},
  "cases": [
    {
      "name": "the text ends inside the visible stage: nothing moves",
      "input": {
        "text": {
          "top": 230,
          "bottom": 400
        },
        "visible": 420
      },
      "output": 0
    },
    {
      "name": "scrolls only as far as lets the text end at the bottom of the visible stage",
      "input": {
        "text": {
          "top": 230,
          "bottom": 485
        },
        "visible": 350
      },
      "output": 135
    },
    {
      "name": "a text taller than the stage starts at the top of the stage",
      "input": {
        "text": {
          "top": 230,
          "bottom": 485
        },
        "visible": 120
      },
      "output": 230
    },
    {
      "name": "the text ends exactly at the bottom of the stage",
      "input": {
        "text": {
          "top": 230,
          "bottom": 420
        },
        "visible": 420
      },
      "output": 0
    },
    {
      "name": "the text ends one pixel below the stage",
      "input": {
        "text": {
          "top": 230,
          "bottom": 421
        },
        "visible": 420
      },
      "output": 1
    },
    {
      "name": "the text starts at the top of the ticket",
      "input": {
        "text": {
          "top": 0,
          "bottom": 500
        },
        "visible": 300
      },
      "output": 0
    },
    {
      "name": "the text is as tall as the stage and starts below the top",
      "input": {
        "text": {
          "top": 100,
          "bottom": 400
        },
        "visible": 300
      },
      "output": 100
    },
    {
      "name": "a stage of nothing",
      "input": {
        "text": {
          "top": 50,
          "bottom": 80
        },
        "visible": 0
      },
      "output": 50
    },
    {
      "name": "fractional pixels",
      "input": {
        "text": {
          "top": 230.5,
          "bottom": 485.25
        },
        "visible": 350.75
      },
      "output": 134.5
    }
  ]
}
