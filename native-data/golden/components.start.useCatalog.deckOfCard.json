{
  "format": 1,
  "module": "components/start/useCatalog",
  "function": "deckOfCard",
  "source": "components/start/useCatalog.ts",
  "tests": [
    "tests/components/start/useCatalog.test.tsx",
    "tests/components/start/unoffered.test.tsx"
  ],
  "cards": {},
  "cases": [
    {
      "name": "the deck whose id and a dash begin the card id",
      "input": {
        "cardId": "aws-clf-c02-t1.1-01",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": "aws-clf-c02"
    },
    {
      "name": "a card of gcp-cdl",
      "input": {
        "cardId": "gcp-cdl-7",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": "gcp-cdl"
    },
    {
      "name": "the longest prefix wins: gcp-cdl-pro keeps its own cards",
      "input": {
        "cardId": "gcp-cdl-pro-1",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": "gcp-cdl-pro"
    },
    {
      "name": "without the longer deck, gcp-cdl-pro-1 belongs to gcp-cdl",
      "input": {
        "cardId": "gcp-cdl-pro-1",
        "deckIds": [
          "gcp-cdl",
          "aws-clf-c02"
        ]
      },
      "output": "gcp-cdl"
    },
    {
      "name": "a deck id that only starts with the same letters is no owner",
      "input": {
        "cardId": "aws-clf-c02x-1",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a card of a deck the index does not have",
      "input": {
        "cardId": "aws-gone-1",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a card id with no dash has no deck",
      "input": {
        "cardId": "x",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a card id that is a deck id has no deck: the dash must follow the id",
      "input": {
        "cardId": "gcp-cdl",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a card id that starts with a dash has no deck",
      "input": {
        "cardId": "-abc",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a short deck id that begins a longer one",
      "input": {
        "cardId": "aws-clf-c02-t1.1-01",
        "deckIds": [
          "aws",
          "aws-clf-c02"
        ]
      },
      "output": "aws-clf-c02"
    },
    {
      "name": "only the short deck matches",
      "input": {
        "cardId": "aws-clf-c03-1",
        "deckIds": [
          "aws",
          "aws-clf-c02"
        ]
      },
      "output": "aws"
    },
    {
      "name": "no decks at all",
      "input": {
        "cardId": "aws-clf-c02-1",
        "deckIds": []
      },
      "output": {
        "$undefined": true
      }
    },
    {
      "name": "a dash at the very end",
      "input": {
        "cardId": "gcp-cdl-",
        "deckIds": [
          "aws-clf-c02",
          "gcp-cdl",
          "gcp-cdl-pro",
          "nextjs-rendering"
        ]
      },
      "output": "gcp-cdl"
    }
  ]
}
