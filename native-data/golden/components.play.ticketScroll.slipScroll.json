{
  "format": 1,
  "module": "components/play/ticketScroll",
  "function": "slipScroll",
  "source": "components/play/ticketScroll.ts",
  "tests": [
    "tests/components/play/ticketScroll.test.ts"
  ],
  "cards": {},
  "cases": [
    {
      "name": "scrolls to the end of the ticket when the slip fits the stage",
      "input": {
        "slip": {
          "top": 500,
          "bottom": 620
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": 340
    },
    {
      "name": "stops at the top of a slip taller than the stage",
      "input": {
        "slip": {
          "top": 300,
          "bottom": 640
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": 300
    },
    {
      "name": "does not move a ticket that fits",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 300
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 0
        }
      },
      "output": null
    },
    {
      "name": "does not move the ticket when the slip ends in the gap: 3 px of scroll",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 303
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 3
        }
      },
      "output": null
    },
    {
      "name": "does not move the ticket when the slip ends exactly at the end of the gap",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 312
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": null
    },
    {
      "name": "does not move the ticket when the scroll is 140 and the slip ends in the gap",
      "input": {
        "slip": {
          "top": 300,
          "bottom": 452
        },
        "at": {
          "top": 140,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": null
    },
    {
      "name": "scrolls once the slip runs one pixel under the action row",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 313
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": 200
    },
    {
      "name": "scrolls to the largest scroll when that is above the slip's top",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 313
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 13
        }
      },
      "output": 13
    },
    {
      "name": "scrolls back up to a slip that starts above the stage",
      "input": {
        "slip": {
          "top": 100,
          "bottom": 200
        },
        "at": {
          "top": 150,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": 100
    },
    {
      "name": "stays at 0 when there is nothing to scroll",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 400
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 12,
          "max": 0
        }
      },
      "output": 0
    },
    {
      "name": "a slip that starts exactly at the top of the stage is in view",
      "input": {
        "slip": {
          "top": 150,
          "bottom": 300
        },
        "at": {
          "top": 150,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": null
    },
    {
      "name": "a slip that starts one pixel above the stage is scrolled to",
      "input": {
        "slip": {
          "top": 149,
          "bottom": 300
        },
        "at": {
          "top": 150,
          "visible": 300,
          "gap": 12,
          "max": 340
        }
      },
      "output": 149
    },
    {
      "name": "no gap",
      "input": {
        "slip": {
          "top": 200,
          "bottom": 301
        },
        "at": {
          "top": 0,
          "visible": 300,
          "gap": 0,
          "max": 340
        }
      },
      "output": 200
    }
  ]
}
