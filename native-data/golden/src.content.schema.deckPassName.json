{
  "format": 1,
  "module": "src/content/schema",
  "function": "deckPassName",
  "source": "src/content/schema.ts",
  "tests": [
    "tests/content/schema.test.ts",
    "tests/content/schema-polish.test.ts"
  ],
  "cards": {},
  "cases": [
    {
      "name": "joins the platform and the deck title when the deck has no pass name",
      "input": {
        "platform": {
          "title": "AWS"
        },
        "deck": {
          "title": "Cloud Practitioner"
        }
      },
      "output": "AWS Cloud Practitioner"
    },
    {
      "name": "uses the deck's pass name when it has one",
      "input": {
        "platform": {
          "title": "Google Cloud"
        },
        "deck": {
          "title": "Cloud Digital Leader",
          "passName": "Google Cloud Digital Leader"
        }
      },
      "output": "Google Cloud Digital Leader"
    },
    {
      "name": "Next.js Rendering",
      "input": {
        "platform": {
          "title": "Next.js"
        },
        "deck": {
          "title": "Rendering"
        }
      },
      "output": "Next.js Rendering"
    },
    {
      "name": "a pass name wins over the platform even when it does not contain it",
      "input": {
        "platform": {
          "title": "AWS"
        },
        "deck": {
          "title": "Fundamentals",
          "passName": "Cloud Fundamentals"
        }
      },
      "output": "Cloud Fundamentals"
    }
  ]
}
