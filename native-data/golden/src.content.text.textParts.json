        {
          "text": "b",
          "code": true
        },
        {
          "text": " and ",
          "code": false
        },
        {
          "text": "`",
          "code": true
        }
      ]
    },
    {
      "name": "a fragment that spans a line break",
      "input": {
        "text": "`line one\nline two` after"
      },
      "output": [
        {
          "text": "line one\nline two",
          "code": true
        },
        {
          "text": " after",
          "code": false
        }
      ]
    },
    {
      "name": "a fragment of spaces",
      "input": {
        "text": "x ` ` y"
      },
      "output": [
        {
          "text": "x ",
          "code": false
        },
        {
          "text": " ",
          "code": true
        },
        {
          "text": " y",
          "code": false
        }
      ]
    },
    {
      "name": "text with accents and emoji around a fragment",
      "input": {
        "text": "Käse `ß` 😀 ende"
      },
      "output": [
        {
          "text": "Käse ",
          "code": false
        },
        {
          "text": "ß",
          "code": true
        },
        {
          "text": " 😀 ende",
          "code": false
        }
      ]
    }
  ]
}
