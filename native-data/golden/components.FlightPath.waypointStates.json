{
  "format": 1,
  "module": "components/FlightPath",
  "function": "waypointStates",
  "source": "components/FlightPath.tsx",
  "tests": [
    "tests/components/FlightPath.test.tsx",
    "tests/components/FlightPath-polish.test.tsx"
  ],
  "cards": {},
  "cases": [
    {
      "name": "answered cards are correct or wrong, the card on screen current, the rest future",
      "input": {
        "total": 5,
        "results": [
          true,
          false
        ],
        "current": 2,
        "answered": false
      },
      "output": [
        "correct",
        "wrong",
        "current",
        "future",
        "future"
      ]
    },
    {
      "name": "the card on screen shows its own mark once it is answered",
      "input": {
        "total": 4,
        "results": [
          true,
          false,
          false
        ],
        "current": 2,
        "answered": true
      },
      "output": [
        "correct",
        "wrong",
        "wrong",
        "future"
      ]
    },
    {
      "name": "before the first answer",
      "input": {
        "total": 10,
        "results": [],
        "current": 0,
        "answered": false
      },
      "output": [
        "current",
        "future",
        "future",
        "future",
        "future",
        "future",
        "future",
        "future",
        "future",
        "future"
      ]
    },
    {
      "name": "the last card answered",
      "input": {
        "total": 3,
        "results": [
          true,
          false,
          true
        ],
        "current": 2,
        "answered": true
      },
      "output": [
        "correct",
        "wrong",
        "correct"
      ]
    },
    {
      "name": "a verdict missing before the card on screen reads as future",
      "input": {
        "total": 4,
        "results": [
          true
        ],
        "current": 2,
        "answered": false
      },
      "output": [
        "correct",
        "future",
        "current",
        "future"
      ]
    },
    {
      "name": "more cards answered than the route has",
      "input": {
        "total": 3,
        "results": [
          true,
          true,
          true,
          true
        ],
        "current": 3,
        "answered": false
      },
      "output": [
        "correct",
        "correct",
        "correct"
      ]
    },
    {
      "name": "a route of no cards",
      "input": {
        "total": 0,
        "results": [],
        "current": 0,
        "answered": false
      },
      "output": []
    },
    {
      "name": "a question on the last card",
      "input": {
        "total": 10,
        "results": [
          true,
          true,
          true,
          true,
          true,
          true,
          true,
          true,
          true
        ],
        "current": 9,
        "answered": false
      },
      "output": [
        "correct",
        "correct",
        "correct",
        "correct",
        "correct",
        "correct",
        "correct",
        "correct",
        "correct",
        "current"
      ]
    }
  ]
}
