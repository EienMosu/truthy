{
  "format": 1,
  "module": "src/progress/progress",
  "function": "seenShare",
  "source": "src/progress/progress.ts",
  "tests": [
    "tests/progress/progress.test.ts",
    "tests/progress/progress-polish.test.ts",
    "tests/progress/partial-read.test.ts"
  ],
  "cards": {},
  "cases": [
    {
      "name": "0 for a deck with no cards",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": []
      },
      "output": 0
    },
    {
      "name": "0 with no history",
      "input": {
        "history": {},
        "cardIds": [
          "a",
          "b"
        ]
      },
      "output": 0
    },
    {
      "name": "0 with neither cards nor history",
      "input": {
        "history": {},
        "cardIds": []
      },
      "output": 0
    },
    {
      "name": "the share of the given cards seen at least once",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          },
          "c": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": [
          "a",
          "b",
          "c",
          "d"
        ]
      },
      "output": 0.5
    },
    {
      "name": "1 when every card has been seen",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          },
          "b": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": [
          "a",
          "b"
        ]
      },
      "output": 1
    },
    {
      "name": "history of cards that are not in the list is ignored",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          },
          "gone": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          },
          "other": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": [
          "a",
          "b"
        ]
      },
      "output": 0.5
    },
    {
      "name": "an entry with a seen count of 0 is not seen",
      "input": {
        "history": {
          "a": {
            "seen": 0,
            "lastCorrect": false,
            "lastSeenAt": 0
          }
        },
        "cardIds": [
          "a"
        ]
      },
      "output": 0
    },
    {
      "name": "a card listed twice counts once",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": [
          "a",
          "a",
          "b"
        ]
      },
      "output": 0.5
    },
    {
      "name": "one third",
      "input": {
        "history": {
          "a": {
            "seen": 1,
            "lastCorrect": true,
            "lastSeenAt": 1
          }
        },
        "cardIds": [
          "a",
          "b",
          "c"
        ]
      },
      "output": 0.3333333333333333
    }
  ]
}
