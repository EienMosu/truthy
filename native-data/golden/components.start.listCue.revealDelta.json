{
  "format": 1,
  "module": "components/start/listCue",
  "function": "revealDelta",
  "source": "components/start/listCue.ts",
  "tests": [
    "tests/components/start/listCue.test.tsx",
    "tests/components/start/reveal-on-return.test.tsx"
  ],
  "cards": {},
  "cases": [
    {
      "name": "a card that shows whole needs no scroll",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 100,
          "bottom": 200
        },
        "room": 8
      },
      "output": 0
    },
    {
      "name": "scrolls down to a card below the view, the fade's room included",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 500,
          "bottom": 600
        },
        "room": 8
      },
      "output": 236
    },
    {
      "name": "scrolls up to a card above the view",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": -150,
          "bottom": -50
        },
        "room": 8
      },
      "output": -158
    },
    {
      "name": "shows the top of a card taller than the view",
      "input": {
        "viewHeight": 100,
        "item": {
          "top": 50,
          "bottom": 300
        },
        "room": 8
      },
      "output": 42
    },
    {
      "name": "a card whose ring just fits at the top",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 8,
          "bottom": 108
        },
        "room": 8
      },
      "output": 0
    },
    {
      "name": "a card one pixel too high for its ring",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 7,
          "bottom": 107
        },
        "room": 8
      },
      "output": -1
    },
    {
      "name": "a card whose fade room just fits at the bottom",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 264,
          "bottom": 364
        },
        "room": 8
      },
      "output": 0
    },
    {
      "name": "a card one pixel too low for the fade room",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 265,
          "bottom": 365
        },
        "room": 8
      },
      "output": 1
    },
    {
      "name": "no room around the card",
      "input": {
        "viewHeight": 400,
        "item": {
          "top": 300,
          "bottom": 400
        },
        "room": 0
      },
      "output": 28
    },
    {
      "name": "a card taller than the view that starts above it",
      "input": {
        "viewHeight": 100,
        "item": {
          "top": -20,
          "bottom": 300
        },
        "room": 8
      },
      "output": -28
    },
    {
      "name": "a card that starts at the top and is taller than the view",
      "input": {
        "viewHeight": 100,
        "item": {
          "top": 8,
          "bottom": 300
        },
        "room": 8
      },
      "output": 0
    },
    {
      "name": "fractional positions",
      "input": {
        "viewHeight": 400.5,
        "item": {
          "top": 301.25,
          "bottom": 420.5
        },
        "room": 8
      },
      "output": 56
    }
  ]
}
