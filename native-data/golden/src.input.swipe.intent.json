{
  "format": 1,
  "module": "src/input/swipe",
  "function": "intent",
  "source": "src/input/swipe.ts",
  "tests": [
    "tests/input/swipe.test.ts",
    "tests/input/swipe-polish.test.ts",
    "tests/input/swipe-early-touch-polish.test.ts"
  ],
  "cards": {},
  "cases": [
    {
      "name": "swipe.test: zero when the card has not moved",
      "input": {
        "dx": 0
      },
      "output": 0
    },
    {
      "name": "swipe.test: proportional inside 110 px (55)",
      "input": {
        "dx": 55
      },
      "output": 0.5
    },
    {
      "name": "swipe.test: proportional inside 110 px (-55)",
      "input": {
        "dx": -55
      },
      "output": -0.5
    },
    {
      "name": "swipe.test: exactly 1 at 110 px",
      "input": {
        "dx": 110
      },
      "output": 1
    },
    {
      "name": "swipe.test: exactly -1 at -110 px",
      "input": {
        "dx": -110
      },
      "output": -1
    },
    {
      "name": "swipe.test: clamped beyond 110 px (500)",
      "input": {
        "dx": 500
      },
      "output": 1
    },
    {
      "name": "swipe.test: clamped beyond 110 px (-500)",
      "input": {
        "dx": -500
      },
      "output": -1
    },
    {
      "name": "boundary: 1 px",
      "input": {
        "dx": 1
      },
      "output": 0.00909090909090909
    },
    {
      "name": "boundary: -1 px",
      "input": {
        "dx": -1
      },
      "output": -0.00909090909090909
    },
    {
      "name": "boundary: 33 px (0.3, which has no exact binary form)",
      "input": {
        "dx": 33
      },
      "output": 0.3
    },
    {
      "name": "boundary: just inside 110 px",
      "input": {
        "dx": 109.99
      },
      "output": 0.9999090909090909
    },
    {
      "name": "boundary: just past 110 px",
      "input": {
        "dx": 110.01
      },
      "output": 1
    },
    {
      "name": "boundary: just inside -110 px",
      "input": {
        "dx": -109.99
      },
      "output": -0.9999090909090909
    },
    {
      "name": "boundary: a fractional drag",
      "input": {
        "dx": 12.345
      },
      "output": 0.11222727272727273
    },
    {
      "name": "boundary: the commit line",
      "input": {
        "dx": 90
      },
      "output": 0.8181818181818182
    },
    {
      "name": "boundary: the fling line to the left",
      "input": {
        "dx": -40
      },
      "output": -0.36363636363636365
    }
  ]
}
