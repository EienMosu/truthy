  "cards": {},
  "cases": [
    {
      "name": "Classic says the score out of the round's total",
      "input": {
        "mode": "classic",
        "score": 7,
        "total": 10
      },
      "output": "7 of 10"
    },
    {
      "name": "Classic uses the total of the round, not the ten of the class card (5 of 7)",
      "input": {
        "mode": "classic",
        "score": 5,
        "total": 7
      },
      "output": "5 of 7"
    },
    {
      "name": "Classic with no correct answer (0 of 12)",
      "input": {
        "mode": "classic",
        "score": 0,
        "total": 12
      },
      "output": "0 of 12"
    },
    {
      "name": "Streak counts in a row",
      "input": {
        "mode": "streak",
        "score": 13,
        "total": 14
      },
      "output": "13 in a row"
    },
    {
      "name": "Streak says 1 in a row, with no plural",
      "input": {
        "mode": "streak",
        "score": 1,
        "total": 2
      },
      "output": "1 in a row"
    },
    {
      "name": "Streak ignores the total",
      "input": {
        "mode": "streak",
        "score": 5,
        "total": 7
      },
      "output": "5 in a row"
    },
    {
      "name": "Three lives counts cards",
      "input": {
        "mode": "lives",
        "score": 21,
        "total": 21
      },
      "output": "21 cards"
    },
    {
      "name": "Timed counts correct answers",
      "input": {
        "mode": "timed",
        "score": 14,
        "total": 17
      },
      "output": "14 correct"
    },
    {
      "name": "Timed with nothing answered",
      "input": {
        "mode": "timed",
        "score": 0,
        "total": 0
      },
      "output": "0 correct"
    },
    {
      "name": "Classic with nothing answered",
      "input": {
        "mode": "classic",
        "score": 0,
        "total": 0
      },
      "output": "0 of 0"
    }
  ]
