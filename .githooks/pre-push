#!/bin/sh
# Refuses a push whose commits carry a local path, a foreign e-mail address, a secret or an attribution line.
# Turn it on once per clone: git config core.hooksPath .githooks
root=$(cd "$(dirname "$0")/.." && pwd)
tsx="$root/node_modules/.bin/tsx"
if [ ! -x "$tsx" ]; then
  echo "pre-push: $tsx is missing; run pnpm install first." >&2
  exit 1
fi
exec "$tsx" "$root/scripts/pre-push.ts"
